class Solution {
public:
    bool lemonadeChange(vector<int>& bills) {
        
        unordered_map<int,int>mpp;

        mpp[5] = 0;
        mpp[10] = 0;
        mpp[20] = 0;

        for(int i=0; i<bills.size(); i++)
        {
            if(bills[i] == 5)
            {
                mpp[5]++;
            }
            else if(bills[i] == 10)
            {
                if(mpp[5] == 0)
                {
                    return false;
                }
                mpp[5]--;
                mpp[10]++;
            }
            else if(bills[i] == 20)
            {
                if(mpp[5] == 0)
                {
                    return false;
                }
                else if(mpp[10] >=1 && mpp[5] >=1)
                {
                    mpp[10]--;
                    mpp[5]--;
                    mpp[20]++;
                }
                else if(mpp[5] >= 3)
                {
                    mpp[5] = mpp[5] - 3;
                    mpp[20]++;
                }
                else
                {
                    return false;
                }
            }
        }
        return true;
    }
};
